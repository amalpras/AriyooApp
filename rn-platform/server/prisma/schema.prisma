generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String
  fullName     String
  userName     String?   @unique
  isSeeker     Boolean   @default(true)
  isSolver     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  tags         UserTag[]
  places       UserPlace[]
  placeTags    UserPlaceTag[]
  seekerSessions Session[] @relation("SeekerSessions")
  solverSessions Session[] @relation("SolverSessions")
}

model Tag {
  id    Int     @id @default(autoincrement())
  name  String  @unique
  users UserTag[]
}

model Place {
  id    Int     @id @default(autoincrement())
  name  String  @unique
  users UserPlace[]
}

model PlaceTag {
  id    Int     @id @default(autoincrement())
  name  String  @unique
  users UserPlaceTag[]
}

model UserTag {
  userId Int
  tagId  Int
  user   User @relation(fields: [userId], references: [id])
  tag    Tag  @relation(fields: [tagId], references: [id])
  @@id([userId, tagId])
}

model UserPlace {
  id      Int   @id @default(autoincrement())
  userId  Int
  placeId Int
  user    User  @relation(fields: [userId], references: [id])
  place   Place @relation(fields: [placeId], references: [id])
  @@unique([userId, placeId])
}

model UserPlaceTag {
  id         Int      @id @default(autoincrement())
  userId     Int
  placeTagId Int
  user       User     @relation(fields: [userId], references: [id])
  placeTag   PlaceTag @relation(fields: [placeTagId], references: [id])
  @@unique([userId, placeTagId])
}

model Session {
  id        Int      @id @default(autoincrement())
  seekerId  Int
  solverId  Int
  title     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  seeker    User     @relation("SeekerSessions", fields: [seekerId], references: [id])
  solver    User     @relation("SolverSessions", fields: [solverId], references: [id])
  messages  Message[]
}

model Message {
  id         Int      @id @default(autoincrement())
  sessionId  Int
  senderId   Int
  messageText String?
  imageUrl   String?
  createdAt  DateTime @default(now())
  session    Session  @relation(fields: [sessionId], references: [id])
}

model Newsletter {
  id    Int    @id @default(autoincrement())
  email String @unique
  createdAt DateTime @default(now())
}